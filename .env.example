# UID/GID of the host user — used so files created inside the container
# are owned by you (not root). Run: id -u && id -g to get these values.
UID=1000
GID=1000

# Log verbosity for the MCP server: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Local host-based MCP (Cursor -> http://localhost:8000/mcp) ────────────────
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PATH=/mcp
PORT=8000
# Public HTTPS origin used in OAuth discovery metadata.
SITE_BASE_URL=https://vetmanager-mcp.vromanichev.ru
# Этап 284: адрес поддержки. Показывается ТОЛЬКО в кабинете вошедшему
# пользователю, на публичный лендинг не попадает никогда. Не задан —
# в кабинете остаётся только ссылка на GitHub Issues.
SUPPORT_EMAIL=
WEB_SESSION_SECRET=
# Generate with: python -c "from secret_manager import generate_storage_encryption_key; print(generate_storage_encryption_key())"
STORAGE_ENCRYPTION_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Production uses PostgreSQL; local dev can keep the default SQLite.
POSTGRES_USER=vetmanager
POSTGRES_PASSWORD=
# Uncomment for production (docker-compose sets this automatically):
# DATABASE_URL=postgresql+asyncpg://vetmanager:CHANGEME@postgres:5432/vetmanager
# Required in production/PostgreSQL for non-reversible feedback fingerprints.
FEEDBACK_FINGERPRINT_PEPPER=

# ── Production rate-limit backend ────────────────────────────────────────────
# For production/multi-instance deployments use the Redis service from
# docker-compose.yml and require fail-closed behavior when Redis is unavailable.
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUIRE_REDIS=1
# RATE_LIMIT_REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# RATE_LIMIT_REDIS_OPERATION_TIMEOUT_SECONDS=1.0
# RATE_LIMIT_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# ── Web security (Этап 285) ──────────────────────────────────────────────────
# Отдаваемое приложением работает только за TLS-терминатором: без HSTS браузер
# первый заход по http ничем не защищает. Включать на боевом контуре; локально
# оставлять пустым — с ним CSP просит upgrade-insecure-requests и http://localhost
# перестаёт открываться.
WEB_ENABLE_HSTS=
# Адреса прокси, чьему X-Forwarded-For мы верим. Не заданы — заголовок
# игнорируется и клиентом считается сам прокси: привязка токена к IP
# привязывает всех к одному адресу, а лимиты входа считаются в общее ведро.
# В docker-compose за nginx это шлюз сети контейнеров (обычно 172.18.0.1).
WEB_TRUSTED_PROXY_IPS=
# То же самое для uvicorn: чьи X-Forwarded-* он разбирает. Держать
# согласованным с WEB_TRUSTED_PROXY_IPS.
FORWARDED_ALLOW_IPS=
# Cookie сессии кабинета. Пусто или не задано — secure, strict и сутки.
# WEB_SESSION_SECURE выключают только для локальной отладки по http.
WEB_SESSION_SECURE=
WEB_SESSION_SAMESITE=
WEB_SESSION_MAX_AGE_SECONDS=

# ── Тонкая настройка (пусто = значение по умолчанию из кода) ──────────────────
# Перечислено, чтобы было видно, что вообще настраивается: все эти имена
# рантайм читает из окружения и все объявлены в сервисе mcp. Значения по
# умолчанию здесь намеренно НЕ продублированы — скопированное число разойдётся
# с кодом и станет документацией, которая врёт. Смотреть в коде по имени.
# WEB_LOGIN_RATE_LIMIT_ATTEMPTS=
# WEB_LOGIN_RATE_LIMIT_WINDOW_SECONDS=
# WEB_REGISTER_RATE_LIMIT_ATTEMPTS=
# WEB_REGISTER_RATE_LIMIT_WINDOW_SECONDS=
# OAUTH_DCR_RATE_LIMIT_ATTEMPTS=
# OAUTH_DCR_RATE_LIMIT_WINDOW_SECONDS=
# OAUTH_TOKEN_RATE_LIMIT_ATTEMPTS=
# OAUTH_TOKEN_RATE_LIMIT_WINDOW_SECONDS=
# BEARER_RATE_LIMIT_REQUESTS=
# BEARER_RATE_LIMIT_WINDOW_SECONDS=
# BREAKER_FAILURE_THRESHOLD=
# BREAKER_WINDOW_SECONDS=
# BREAKER_COOLDOWN_SECONDS=
# BILLING_RESOLVER_CACHE_TTL_SECONDS=
# VM_HTTP_CLIENT_CLOSE_GRACE_SECONDS=
# DB_POOL_SIZE=
# DB_MAX_OVERFLOW=
# REPORT_EXPORT_DIR=
# LOG_FORMAT=
# FASTMCP_LOG_LEVEL=
# ERROR_TRACKING_BACKEND=
# SENTRY_DSN=
# FILTER_CONTRACT_VALIDATION_ENABLED=
# SORT_CONTRACT_VALIDATION_ENABLED=
# STREAMABLE_HTTP_DRAIN_ENABLED=

# ── Test credentials (used ONLY for e2e real-API tests) ──────────────────────
# Runtime credentials Vetmanager are not stored here.
# MCP clients use Authorization: Bearer <service_token>; clinic domain/api_key
# live inside the service account storage layer.
TEST_DOMAIN=
TEST_API_KEY=
TEST_USER_TOKEN=
TEST_USER_TOKEN_BASE_URL=
TEST_USER_LOGIN=
TEST_USER_PASSWORD=
